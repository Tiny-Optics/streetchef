# Server
PORT=4000

# MongoDB — required variable name is MONGODB_URI (MONGO_URI is accepted but deprecated)
#
# Local Docker (default `make build` uses COMPOSE_PROFILES=local):
#   MONGODB_URI=mongodb://mongo:27017/streetchef
#
# MongoDB Atlas (skip local mongo: COMPOSE_PROFILES= make build):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/streetchef
#   Include /streetchef in the path so data lands in the streetchef database.
#   Atlas → Network Access: allow your IP (or 0.0.0.0/0 for dev only).
#
# Backend on host (no Docker):
#   MONGODB_URI=mongodb://localhost:27017/streetchef
MONGODB_URI=mongodb://mongo:27017/streetchef

# Better Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-minimum-secret
# Browser URL where the API is reached (localhost even when backend runs in Docker)
BETTER_AUTH_URL=http://localhost:4000

# Frontend origin for CORS and trusted origins (browser URL, not the Docker service name)
FRONTEND_URL=http://localhost:3000

# SMTP (required for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@streetchef.com
